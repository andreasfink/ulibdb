#ulib pkg-config source file

prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Cflags: -I${includedir} -I/usr/include/mariadb -I/usr/include/mariadb/mysql -I/usr/include/postgresql
Libs: -L${libdir} -l:libulibdb.so.2.0   

Name: ulibdb
Description: universal database library
Version: 2.0.0
Requires: ulib mariadb libpq


